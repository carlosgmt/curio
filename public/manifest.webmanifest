{
  "id": "/curio/",
  "name": "Curio",
  "short_name": "Curio",
  "description": "Smart Self-Organizing Memory & Taste Graph",
  "start_url": "/curio/",
  "scope": "/curio/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fafaf9",
  "theme_color": "#1c1917",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "/curio/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/curio/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/curio/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/curio/api/v1/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "image", "accept": ["image/*"] }]
    }
  }
}
