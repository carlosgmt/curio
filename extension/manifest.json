{
  "manifest_version": 3,
  "name": "Curio Capture",
  "version": "1.0.0",
  "description": "1-tap capture of cultural artifacts, cinema, literature, and wine to your Curio Taste Graph.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
