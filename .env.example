# .env.example — copy to .env and fill in values
MORPHE_DB_PATH=/data/morphe.db
MORPHE_ATTACHMENTS_DIR=/data/attachments
MORPHE_LISTEN_ADDR=:8080

# Optional: TypeSafe Jev API key for online intent classification
TYPESAFE_API_KEY=

# Image AI provider: ollama | gemini | none
MORPHE_AI_PROVIDER=ollama
MORPHE_OLLAMA_URL=http://hm:11434
MORPHE_OLLAMA_MODEL=llava:13b

# Fallback: Gemini Vision API key
MORPHE_GEMINI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://morphe-backend:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3100
