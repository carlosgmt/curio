{
  "manifest_version": 3,
  "name": "Curio Capture",
  "version": "1.2.0",
  "description": "1-tap capture and automatic Instagram session sync for your Curio Taste Graph.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.instagram.com/*",
    "http://127.0.0.1:3000/*",
    "https://mini.orca-banjo.ts.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
